# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Local example: mongodb://127.0.0.1:27017/spendwise
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/spendwise

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Allowed Frontend Origin for CORS and Cookies
CLIENT_URL=http://localhost:5173
