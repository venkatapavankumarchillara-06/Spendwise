# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI)
# Replace USERNAME, PASSWORD, and CLUSTER_URL with your actual MongoDB Atlas cluster credentials
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_URL/spendwise?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Allowed Frontend Origin for CORS and Cookies
CLIENT_URL=http://localhost:5173
